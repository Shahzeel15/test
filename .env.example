DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/softframe
APP_PASSWORD=choose-a-long-private-passcode
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# Set PGSSL=true only if your database provider requires SSL.
PGSSL=false
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional: defaults to openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b
